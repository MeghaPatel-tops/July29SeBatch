DELIMITER $$
CREATE PROCEDURE increseSalaryPRoduct()
BEGIN
DECLARE    ppid int ;
DECLARE   pprice float;
DECLARE isDone int  DEFAULT false;
DECLARE  cur1 CURSOR FOR SELECT ppid,pprice from products;
DECLARE CONTINUE HANDLER FOR NOT FOUND SET isDone = true;


open cur1;
floop :LOOP

FETCH cur1 into ppid,pprice;

if isDone THEN
   LEAVE floop;
END if;

UPDATE products set price = pprice+200 where pid=ppid;

end LOOP floop;

CLOSE cur1;
END $$ 
DELIMITER ;


call increseSalaryPRoduct()



