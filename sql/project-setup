CREATE TABLE category(cid int PRIMARY KEY AUTO_INCREMENT,catname varchar(20));


CREATE TABLE products(pid int PRIMARY KEY AUTO_INCREMENT,pname varchar(30),price float, description varchar(250),catid int, FOREIGN KEY(catid) REFERENCES category(cid));


CREATE TABLE users(uid int PRIMARY KEY AUTO_INCREMENT, username varchar(30),email varchar(50),contact varchar(20),pwd varchar(10));

CREATE TABLE cart(cartid int PRIMARY KEY AUTO_INCREMENT,pid int ,uid int, dateof date,FOREIGN KEY(pid)REFERENCES products(pid), FOREIGN KEY(uid) REFERENCES users(uid))


CREATE TABLE `orders` (
  `orderid` int(11) NOT NULL,
  
  `cartid` int(11) DEFAULT NULL,
  `amount` float DEFAULT NULL,
  `dateof` date DEFAULT NULL
) 


